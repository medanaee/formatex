{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window. Add a permission here only when a feature needs it.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }, { "url": "mailto:*" }]
    },
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/documents" },
        { "path": "$APPDATA/documents/**" },
        { "path": "$APPDATA/fonts" },
        { "path": "$APPDATA/fonts/**" }
      ]
    }
  ]
}
