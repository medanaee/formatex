  paper: (
    dark: false,
    bg: rgb("#ffffff"),
    fg: rgb("#24292f"),
    heading: rgb("#1f3a5f"),
    muted: rgb("#6a737d"),
    accent: rgb("#2f6db5"),
    secondary: rgb("#2f6db5"),
    rule: rgb("#c4ccd4"),
    code-bg: rgb("#f6f8fa"),
    code-stroke: rgb("#d8dee4"),
