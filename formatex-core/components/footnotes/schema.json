{
  "fn": {
    "kind": "inline",
    "description": {
      "en": "Footnote written in place; `en` / `fa` give a text per language",
      "fa": "پاورقی درون‌متنی؛ `en` و `fa` متن هر زبان را می‌دهند"
    },
    "attrs": {
      "en": {
        "type": "string",
        "doc": {
          "en": "Note text for English text",
          "fa": "متن پاورقی برای متن انگلیسی"
        }
      },
      "fa": {
        "type": "string",
        "doc": {
          "en": "Note text for Persian text",
          "fa": "متن پاورقی برای متن فارسی"
        }
      },
      "text": {
        "type": "string",
        "doc": {
          "en": "Note text for any language",
          "fa": "متن پاورقی برای هر زبان"
        }
      },
      "dir": {
        "type": "enum",
        "values": [
          "auto",
          "rtl",
          "ltr"
        ],
        "default": "auto",
        "doc": {
          "en": "Direction of the note",
          "fa": "جهت پاورقی"
        }
      }
    }
  },
  "footnote": {
    "kind": "inline",
    "description": {
      "en": "Footnote written in place (same as <fn>)",
      "fa": "پاورقی درون‌متنی (مثل <fn>)"
    },
    "attrs": {
      "en": {
        "type": "string",
        "doc": {
          "en": "Note text for English text",
          "fa": "متن پاورقی برای متن انگلیسی"
        }
      },
      "fa": {
        "type": "string",
        "doc": {
          "en": "Note text for Persian text",
          "fa": "متن پاورقی برای متن فارسی"
        }
      },
      "text": {
        "type": "string",
        "doc": {
          "en": "Note text for any language",
          "fa": "متن پاورقی برای هر زبان"
        }
      },
      "dir": {
        "type": "enum",
        "values": [
          "auto",
          "rtl",
          "ltr"
        ],
        "default": "auto",
        "doc": {
          "en": "Direction of the note",
          "fa": "جهت پاورقی"
        }
      }
    }
  }
}
